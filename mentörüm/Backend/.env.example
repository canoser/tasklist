# MentorumApi — örnek ortam değişkenleri.
# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun. Secrets'ı asla commit etmeyin (.env gitignore'da).
DATABASE_URL="Host=<neon-host>;Database=mentorum;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;"
JWT_SECRET=32-karakterden-uzun-rastgele-bir-secret
JWT_ISSUER=mentorum
JWT_AUDIENCE=mentorum-users
SUPER_ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
# Virgülle ayrılmış izinli origin listesi (CORS)
CORS_ORIGINS=http://localhost:5173,https://mentorum.dersmatris.com
