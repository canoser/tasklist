<Window x:Class="planlama_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:planlama_app.Converters"
        xmlns:views="clr-namespace:planlama_app.Views"
        mc:Ignorable="d"
        Title="TaskList - Görev &amp; Planlama Yönetimi"
        Height="780" Width="1200"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Style="{StaticResource MaterialDesignWindow}"
        KeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <conv:GroupExpandedConverter x:Key="GroupExpandedConverter"/>
        <conv:GroupColorConverter x:Key="GroupColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sol Gezinti Çekmecesi (Left Navigation Sidebar) -->
            <ColumnDefinition x:Name="ColNavSidebar" Width="240"/>
            <!-- Ana İçerik Alanı -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             SOL NAVİGASYON PANELERİ (Left Navigation Sidebar)
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Logo & Uygulama Başlığı -->
                    <RowDefinition Height="Auto"/>
                    <!-- Hızlı Aksiyon (+ Yeni Görev) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Kategoriler / Görev Grupları Listesi -->
                    <RowDefinition Height="*"/>
                    <!-- Alt Araçlar / Kaynaklar Butonu -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Logo Header -->
                <Border Grid.Row="0" Padding="16,14" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarCheck" Width="26" Height="26" Foreground="{DynamicResource MaterialDesignPrimaryDarkBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="TaskList" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.1" FontSize="10" Opacity="0.5" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>

                <!-- Hızlı Aksiyon (+ Yeni Görev) -->
                <Button x:Name="BtnQuickAddTask" Grid.Row="1" Margin="14,12,14,8" Click="BtnQuickAddTask_Click" Style="{StaticResource MaterialDesignRaisedButton}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Yeni Görev Ekle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Kategoriler / Sekmeler Listesi -->
                <Grid Grid.Row="2" Margin="8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,8,8,6">
                        <TextBlock Text="GÖREV GRUPLARI" FontSize="11" FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center"/>
                        <Button x:Name="BtnAddCategory" Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" HorizontalAlignment="Right" Click="BtnAddCategory_Click" ToolTip="Yeni Kategori / Grup Ekle">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="LstSidebarCategories" Grid.Row="1" SelectionChanged="LstSidebarCategories_SelectionChanged" Style="{StaticResource MaterialDesignListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="✏ Yeniden Adlandır" Click="MnuRenameCategory_Click" Tag="{Binding Category}"/>
                                            <MenuItem Header="🔗 Kaynak Bağla / Değiştir" Click="MnuAssignCategoryResource_Click" Tag="{Binding Category}"/>
                                            <MenuItem Header="🗑 Sil" Click="MnuDeleteCategory_Click" Tag="{Binding Category}" Foreground="Red"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Column="1" Background="{DynamicResource MaterialDesignSelection}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TaskCount}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Alt Araçlar / Kaynaklar Butonu -->
                <Border Grid.Row="3" Padding="10,8" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
                    <Button x:Name="BtnToggleSidebar"
                            Click="BtnToggleSidebar_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,6" Height="36"
                            ToolTip="Kaynaklar panelini aç/kapat">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="BookmarkMultipleOutline" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kaynaklar Paneli" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             SAĞ ANA İÇERİK BÖLGESİ (Right Main Content Area)
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Tek Satırlık Şık Üst Çubuk (Single-row Top Header) -->
                <RowDefinition Height="Auto"/>
                <!-- Ana İçerik (Takvim / Liste / Bölünmüş) -->
                <RowDefinition Height="*"/>
                <!-- Durum Çubuğu -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 TEK SATIRLIK ÜST BAR
            ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Sol Menü Butonu & Aktif Grup Başlığı -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleNavSidebar" Click="BtnToggleNavSidebar_Click" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Sol Menüyü Gizle/Göster" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Menu" Width="22" Height="22"/>
                        </Button>

                        <TextBlock x:Name="TxtActiveCategoryTitle" Text="Tüm Görevler" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        
                        <Border x:Name="BadgeActiveCount" Background="{DynamicResource MaterialDesignSelection}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveCategoryCount" Text="0 görev" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Orta: Kayar Arama Kutusu (Büyüteç Butonu + Arama) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnSearchToggle" Click="BtnSearchToggle_Click" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Görev Ara">
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"/>
                        </Button>
                        
                        <Border x:Name="BorderSearchBox" Width="0" ClipToBounds="True" Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBox x:Name="TxtSearch"
                                     Width="220"
                                     materialDesign:HintAssist.Hint="Görevlerde ara..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="8,5"
                                     TextChanged="TxtSearch_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Sağ: Mod Switcher + Filtre Menüsü + Araçlar Menüsü -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Görünüm Seçici (Takvim / Liste / Bölünmüş) -->
                        <Border CornerRadius="6" Background="{DynamicResource MaterialDesignCardBackground}" Padding="2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbViewCalendar" Content="📅 Takvim" Style="{StaticResource MaterialDesignChoiceChipRadioButton}" Click="ViewMode_Click" Margin="0,0,2,0"/>
                                <RadioButton x:Name="RbViewList" Content="📋 Liste" Style="{StaticResource MaterialDesignChoiceChipRadioButton}" Click="ViewMode_Click" Margin="0,0,2,0"/>
                                <RadioButton x:Name="RbViewSplit" Content="🔀 Bölünmüş" Style="{StaticResource MaterialDesignChoiceChipRadioButton}" IsChecked="True" Click="ViewMode_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Filtreler Menü Popup Butonu -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                 ToolTip="Filtrele"
                                                 Margin="0,0,6,0">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="FilterVariant" Width="22" Height="22"/>
                            </materialDesign:PopupBox.ToggleContent>

                            <Border Padding="16" Width="220">
                                <StackPanel>
                                    <TextBlock Text="Filtrele" FontWeight="Bold" Margin="0,0,0,12"/>
                                    
                                    <!-- Tür Filtresi -->
                                    <TextBlock Text="Görev Türü" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbFilter" SelectionChanged="CmbFilter_SelectionChanged" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Tüm Türler" IsSelected="True"/>
                                        <ComboBoxItem Content="Bağımsız"/>
                                        <ComboBoxItem Content="Zincirleme"/>
                                    </ComboBox>

                                    <!-- Tamamlananları Gizle -->
                                    <CheckBox x:Name="ChkHideCompleted" Content="Tamamlananları Gizle" Checked="Filter_Changed" Unchecked="Filter_Changed" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </StackPanel>
                            </Border>
                        </materialDesign:PopupBox>

                        <!-- Araçlar & İşlemler Menü Popup Butonu (Genişletilmiş ve Şık Tasarım) -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                 ToolTip="İşlemler &amp; Ayarlar">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="DotsVertical" Width="22" Height="22"/>
                            </materialDesign:PopupBox.ToggleContent>

                            <Border Padding="14" Width="250">
                                <StackPanel>
                                    <TextBlock Text="İşlemler &amp; Ayarlar" FontWeight="Bold" Margin="0,0,0,10"/>
                                    
                                    <Button Click="BtnImport_Click" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="8,6" Height="34">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileImport" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="TXT'den İçe Aktar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnTemplate_Click" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="8,6" Height="34">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="AI/LLM Şablonu Aç" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,8"/>

                                    <!-- Tema Seçimi -->
                                    <TextBlock Text="Tema Seçimi" FontSize="11.5" Opacity="0.7" Margin="8,0,0,4"/>
                                    <ComboBox x:Name="CmbTheme" SelectionChanged="CmbTheme_SelectionChanged" Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="8,4" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Koyu Tema (Dark)"/>
                                        <ComboBoxItem Content="Monokai"/>
                                        <ComboBoxItem Content="Monokai Dimmed"/>
                                        <ComboBoxItem Content="Abyss"/>
                                        <ComboBoxItem Content="Tokyo Night Light"/>
                                    </ComboBox>

                                    <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,4,0,8"/>

                                    <!-- Geri Al ve İleri Al Butonları -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnUndo" Grid.Column="0" Click="BtnUndo_Click" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="4,4" Height="32" Margin="0,0,4,0" ToolTip="Geri Al (Ctrl+Z)">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Undo" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Geri Al" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnRedo" Grid.Column="1" Click="BtnRedo_Click" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="4,4" Height="32" Margin="4,0,0,0" ToolTip="İleri Al (Ctrl+Y)">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Redo" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="İleri Al" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 İÇERİK BÖLGESİ (Takvim / Liste / Bölünmüş + Sağ Kaynaklar Paneli)
            ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ana Görünüm Alanı (Grid for Calendar + List split) -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Takvim -->
                        <ColumnDefinition x:Name="ColCalendar" Width="1.2*"/>
                        <!-- GridSplitter -->
                        <ColumnDefinition x:Name="ColSplitter" Width="Auto"/>
                        <!-- Column 2: Liste -->
                        <ColumnDefinition x:Name="ColList" Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TAKVİM KONTROLÜ -->
                    <Border x:Name="BorderCalendar" Grid.Column="0" Margin="4">
                        <views:CalendarView x:Name="CalendarControl"/>
                    </Border>

                    <!-- SPLITTER -->
                    <GridSplitter x:Name="ViewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                                  Background="{DynamicResource MaterialDesignDivider}" Margin="0,4"/>

                    <!-- GÖREV LİSTESİ ALANI -->
                    <Grid x:Name="GridTaskListArea" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- LİSTE ÜST BAR (Görünüm Ayarları & Tarih Filtresi Göstergesi) -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource MaterialDesignCardBackground}" 
                                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                BorderThickness="0,0,0,1" 
                                Padding="8,6" 
                                Margin="4,4,4,4" 
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sol: Seçili Tarih Filtresi Rozeti / Başlığı -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="BorderDateFilterBadge" 
                                            Background="{DynamicResource MaterialDesignSelection}" 
                                            CornerRadius="12" 
                                            Padding="8,4" 
                                            Visibility="Collapsed" 
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CalendarFilter" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSelectedDateFilter" Text="25.07.2026 Görevleri" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnClearDateFilter" Click="BtnClearDateFilter_Click" Style="{StaticResource MaterialDesignIconButton}" Width="18" Height="18" Margin="6,0,0,0" ToolTip="Tarih Filtresini Temizle">
                                                <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TxtListHeaderTitle" Text="Görev Listesi" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>

                                <!-- Sağ: Liste Gruplama Görünüm Modları -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Görünüm:" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border CornerRadius="4" Background="{DynamicResource MaterialDesignPaper}" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbGroupStandard" Content="📋 Varsayılan" Style="{StaticResource MaterialDesignChoiceChipRadioButton}" Click="ListGroupMode_Click" IsChecked="True" FontSize="11" Margin="0,0,2,0"/>
                                            <RadioButton x:Name="RbGroupDaily" Content="📅 Gün" Style="{StaticResource MaterialDesignChoiceChipRadioButton}" Click="ListGroupMode_Click" FontSize="11" Margin="0,0,2,0"/>
                                            <RadioButton x:Name="RbGroupWeekly" Content="📆 Hafta" Style="{StaticResource MaterialDesignChoiceChipRadioButton}" Click="ListGroupMode_Click" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- LİSTE İÇERİĞİ -->
                        <Grid Grid.Row="1">
                            <!-- Boş durum mesajı -->
                            <StackPanel x:Name="PanelEmpty"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                        Width="64" Height="64"
                                                        HorizontalAlignment="Center"
                                                        Opacity="0.25"/>
                                <TextBlock Text="Görev bulunamadı"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.4"
                                           Margin="0,8,0,4"/>
                                <TextBlock Text="Aşağıdaki buton ile yeni görev veya içe aktarma yapabilirsiniz."
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.3"
                                           TextAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <Button x:Name="BtnEmptyImport" Click="BtnImport_Click"
                                        Style="{StaticResource MaterialDesignFlatMidBgButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileImport" Width="18" Height="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="İçe Aktar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- ListView -->
                            <ListView x:Name="LvTasks"
                                      ItemsSource="{Binding}"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      Margin="8,4,8,4"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Margin" Value="0,6,0,4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="{Binding Name, Converter={StaticResource GroupExpandedConverter}, Mode=OneWay}"
                                                                      Margin="2,2,2,2">
                                                                <Expander.Header>
                                                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                                                        <Border Width="12" Height="12" CornerRadius="6" 
                                                                                Background="{Binding Name, Converter={StaticResource GroupColorConverter}}" 
                                                                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                                        <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} görev'}" FontSize="11" Opacity="0.7"/>
                                                                        </Border>
                                                                        
                                                                        <CheckBox Style="{StaticResource MaterialDesignCheckBox}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                                                  Tag="{Binding Name}" Checked="ChkSelectGroup_Checked" Unchecked="ChkSelectGroup_Unchecked" ToolTip="Grubun tümünü seç"/>
                                                                    </StackPanel>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListView.GroupStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TaskItem}" xmlns:models="clr-namespace:planlama_app.Models">
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,8,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Seçim ve Durum Checkbox -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource MaterialDesignCheckBox}" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed" ToolTip="Seç" Margin="0,0,4,0"/>
                                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Style="{StaticResource MaterialDesignCheckBox}" Click="ChkCompleted_Click" ToolTip="Tamamlandı olarak işaretle"/>
                                                </StackPanel>

                                                <!-- Detaylar -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Border Visibility="{Binding CategoryName, Converter={StaticResource GroupExpandedConverter}}" Background="{DynamicResource MaterialDesignSelection}" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Ek bilgiler: Tarih, Süre, Zincir, Kaynak -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding DueDate, StringFormat='📅 {0:dd.MM.yyyy}'}" FontSize="11" Opacity="0.7" Margin="0,0,12,0"/>
                                                        
                                                        <TextBlock Visibility="{Binding EstimatedTime, Converter={StaticResource GroupExpandedConverter}}"
                                                                   Text="{Binding EstimatedTime, StringFormat='⏱ {0} dk'}" FontSize="11" Opacity="0.7" Margin="0,0,12,0"/>

                                                        <TextBlock Visibility="{Binding ChainId, Converter={StaticResource GroupExpandedConverter}}"
                                                                   Text="{Binding ChainId, StringFormat='⛓ {0}'}" FontSize="11" Foreground="DodgerBlue" Margin="0,0,12,0"/>

                                                        <Border Visibility="{Binding ResourceTitle, Converter={StaticResource GroupExpandedConverter}}"
                                                                Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="4" Padding="4,1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ResourceUrl}">
                                                                <materialDesign:PackIcon Kind="LinkVariant" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="DodgerBlue"/>
                                                                <TextBlock Text="{Binding ResourceTitle}" FontSize="10.5" FontWeight="SemiBold" Foreground="DodgerBlue"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- İşlem Butonları -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Click="BtnPostpone_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" ToolTip="1 Gün Ertele" Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="ClockPlusOutline" Width="16" Height="16"/>
                                                    </Button>

                                                    <Button Click="BtnEdit_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" ToolTip="Düzenle" Margin="0,0,4,0">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                                    </Button>

                                                    <Button Click="BtnDelete_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Foreground="Red" Width="28" Height="28" ToolTip="Sil">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════
                     SAĞ YAN PANEL (Kaynaklar / Sidebar)
                ═══════════════════════════════════════════════════════════ -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Width="300"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1,0,0,0">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="🔖 Kaynaklar &amp; Notlar" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Click="BtnCloseSidebar_Click" Style="{StaticResource MaterialDesignIconButton}" HorizontalAlignment="Right" Width="24" Height="24">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <ListView x:Name="LvResources" Grid.Row="1" SelectionMode="Single" Margin="0,4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4" Background="Transparent">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🗑 Kaynağı Sil" Click="MnuDeleteResource_Click" Tag="{Binding}" Foreground="Red"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Url}" TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" Click="BtnAddResource_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Yeni Kaynak Ekle"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- YÜZEN SEÇİM ÇUBUĞU (Floating Contextual Action Bar) -->
                <Border x:Name="BorderSelectionBar"
                        Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,24" Background="{DynamicResource MaterialDesignPaper}"
                        CornerRadius="24" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                        Padding="18,8" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckboxMarked" Width="20" Height="20" Foreground="{DynamicResource MaterialDesignPrimaryDarkBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSelectedCount" Text="0 görev seçildi" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Button Click="BtnDeleteSelected_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Padding="12,4" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Seçilenleri Sil" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 DURUM ÇUBUĞU & YÜKLENİYOR SİMGESİ
            ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Padding="12,4"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="LoadingSpinner"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0" IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Visibility="Collapsed"
                                     Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus"
                                   Text="Hazır."
                                   FontSize="12"
                                   Opacity="0.8"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="TaskList v1.1" FontSize="11" Opacity="0.5"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
